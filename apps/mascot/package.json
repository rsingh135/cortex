{
  "name": "@cortex/mascot",
  "version": "0.0.0",
  "private": true,
  "description": "Cortex mascot: a desktop pet that sits on top of your screen and answers from your real memory via the engine.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
