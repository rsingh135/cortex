# MongoDB Atlas sandbox cluster (hackathon-provided). Required for atlas:check and every service.
ATLAS_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
ATLAS_DB=cortex

# Model provider for the engine: openai | anthropic | none. Default: anthropic when ANTHROPIC_API_KEY is
# set, else openai when OPENAI_API_KEY is set, else none (model routes return 503).
LLM_PROVIDER=

# Claude. claude-sonnet-5 for extraction and routing, claude-opus-5 for answers / learner / agent / judge.
ANTHROPIC_API_KEY=
# Only for org-level keys (Anthropic returns "not scoped to a workspace" without it).
ANTHROPIC_WORKSPACE_ID=

# OpenAI. Used by the engine when set (see LLM_PROVIDER). Defaults: gpt-5.4-mini for extraction and
# routing, gpt-5.4 for answers.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_ROUTER_MODEL=gpt-5.4-mini
OPENAI_ASK_MODEL=gpt-5.4

# Voyage embeddings: Atlas model API key; separate from Atlas database/CLI credentials.
# Keep the same model for document and query vectors; rebuild vectors when changing models.
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

# ElevenLabs speech-to-text (voice notes) and text-to-speech (dream journal).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=56bWURjYFHyYyVf490Dp

# LangSmith tracing and experiments.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=cortex

# Shared secret the Playwright scripts and agent send as `x-cortex-write-token` on mock-world write endpoints.
CORTEX_WRITE_TOKEN=change-me
# Dev only: lets the browser UI of the mock world send the write token itself.
NEXT_PUBLIC_CORTEX_WRITE_TOKEN=change-me

# Engine (ingest + live WebSocket) as seen by the palace. Local for the demo laptop; cloudflared tunnel URL for the Vercel palace.
ENGINE_HTTP_URL=http://localhost:4000
NEXT_PUBLIC_LIVE_SERVER_WS_URL=ws://localhost:4000/ws
